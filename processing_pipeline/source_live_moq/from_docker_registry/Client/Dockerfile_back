FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV GST_VERSION=1.28

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    pkg-config \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    flex bison \
    # orc system (évite le sous-projet qui cherche hotdoc)
    liborc-0.4-dev \
    libglib2.0-dev \
    libssl-dev \
    libxml2-dev \
    libdrm-dev \
    libx11-dev \
    libxext-dev \
    libxv-dev \
    libasound2-dev \
    libpulse-dev \
    libvpx-dev \
    libx264-dev \
    libx265-dev \
    libaom-dev \
    libdav1d-dev \
    libde265-dev \
    wget curl \
    ca-certificates \
    && pip3 install --break-system-packages meson==1.4.0 ninja \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

RUN git clone --depth=1 --branch ${GST_VERSION} \
    https://gitlab.freedesktop.org/gstreamer/gstreamer.git

WORKDIR /opt/gstreamer

RUN meson setup build \
     --prefix=/usr \
     --buildtype=release \
    -Dtests=disabled \
    -Ddoc=disabled \
    -Dintrospection=enabled \
    -Dgpl=enabled

# RUN meson setup build \
